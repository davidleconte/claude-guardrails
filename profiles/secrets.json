{
  "//": "Portability proof: a non-quant profile. Pre-commit secret scan.",
  "precheck": {
    "trigger": "git commit*",
    "include": ["*"],
    "exclude": ["(^|/)\\.git/", "(^|/)node_modules/", "\\.min\\.(js|css)$", "(^|/)\\.venv/", "(^|/)dist/"],
    "rules": [
      {"pattern": "sk-[A-Za-z0-9_-]{16,}", "label": "clé de type sk-… en clair", "severity": "high"},
      {"pattern": "AKIA[0-9A-Z]{16}", "label": "AWS Access Key ID en clair", "severity": "high"},
      {"pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "label": "clé privée en clair", "severity": "high"},
      {"pattern": "(password|passwd|secret|token)\\s*[:=]\\s*[\"'][^\"']{6,}", "label": "secret potentiel affecté en dur", "severity": "med"}
    ]
  }
}
